const SHEET_ID="ID_HOJA";const DRIVE_FOLDER_ID="ID_CARPETA";
function doGet(e){if(e.parameter.action==='questions'){const s=SpreadsheetApp.openById(SHEET_ID).getSheetByName('BancoPreguntas');const d=s.getDataRange().getValues().slice(1).map(r=>({tipo:r[0],pregunta:r[1]}));return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}}
function doPost(e){const p=JSON.parse(e.postData.contents);const sh=SpreadsheetApp.openById(SHEET_ID).getSheetByName('Respuestas');const folder=DriveApp.getFolderById(DRIVE_FOLDER_ID);p.respuestas.forEach(r=>{let url='';if(r.imagen){const blob=Utilities.newBlob(Utilities.base64Decode(r.imagen.split(',')[1]),'image/png','evidencia.png');url=folder.createFile(blob).getUrl();}sh.appendRow([p.estudiante,r.tipo,r.pregunta,r.respuestaTexto,url]);});return ContentService.createTextOutput('OK');}